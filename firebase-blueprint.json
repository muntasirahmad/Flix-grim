{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile with authentication and subscription tier",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoUrl": {
          "type": "string",
          "description": "User avatar URL"
        },
        "isPro": {
          "type": "boolean",
          "description": "Whether user has an active Pro subscription"
        },
        "planId": {
          "type": "string",
          "description": "Current plan identifier (e.g. 1-month, 1-year)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "chatSession": {
      "title": "Chat Session",
      "description": "Individual conversation history session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Conversation title"
        },
        "modelId": {
          "type": "string",
          "description": "Selected model ID (gemini, chatgpt, deepseek, etc.)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        }
      },
      "required": ["id", "userId", "title", "modelId"]
    },
    "message": {
      "title": "Chat Message",
      "description": "Message entry in a chat session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message identifier"
        },
        "chatId": {
          "type": "string",
          "description": "Parent session identifier"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "ai"],
          "description": "Sender role"
        },
        "text": {
          "type": "string",
          "maxLength": 50000,
          "description": "Message content"
        },
        "modelName": {
          "type": "string",
          "description": "Name of AI model that generated the message"
        },
        "timestamp": {
          "type": "string",
          "description": "Display timestamp string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "chatId", "sender", "text"]
    },
    "googleChatSpace": {
      "title": "Google Chat Space",
      "description": "Reference to linked Google Chat space",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID who owns this space reference"
        },
        "spaceName": {
          "type": "string",
          "description": "Resource name in Google Chat API"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Space display name"
        },
        "spaceType": {
          "type": "string",
          "description": "SPACE, GROUP_CHAT, or DIRECT_MESSAGE"
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sync timestamp"
        }
      },
      "required": ["userId", "spaceName", "displayName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "user" },
      "description": "Private user profiles"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "chatSession" },
      "description": "User chat sessions"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "message" },
      "description": "Messages within a session"
    },
    "/users/{userId}/googleChatSpaces/{spaceId}": {
      "schema": { "$ref": "googleChatSpace" },
      "description": "User Google Chat spaces"
    }
  }
}
